# Network the frontend reads and writes against: mainnet | testnet
NEXT_PUBLIC_NETWORK=mainnet

# Deployer of vaultstx-escrow / vaultstx-factory / vaultstx-dispute
NEXT_PUBLIC_CONTRACT_ADDRESS=SP1SY1E599GN04XRD2DQBKV7E62HYBJR2CT9S5QKK

# Optional contract-name overrides (defaults shown). Set these if a redeploy
# renamed a contract so nothing is hard-coded in the bundle.
# NEXT_PUBLIC_ESCROW_CONTRACT=vaultstx-escrow
# NEXT_PUBLIC_DISPUTE_CONTRACT=vaultstx-dispute
# NEXT_PUBLIC_FACTORY_CONTRACT=vaultstx-factory
